# Snyk (https://snyk.io) policy file

version: v1.25.0

ignore:
  SNYK-JAVA-LOG4J-1300176:
    - '*':
        reason: >-
          Log4j 1.2.17 is EOL. Upgrading to log4j2 requires significant API
          migration and code refactoring. Given LOW severity and development
          effort required, this vulnerability is accepted. Future work should
          migrate to log4j2 or SLF4J with logback.
        expires: 2025-04-03T00:00:00.000Z
        created: 2025-10-03T06:00:00.000Z

patch: {}
